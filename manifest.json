{
	"manifest_version": 3,
	"name": "Albert Planner",
	"version": "1.0.1",
	"description": "Plan your NYU Albert schedule — scrapes your shopping cart into a weekly calendar with conflict detection and priority buckets.",
	"permissions": [
		"storage",
		"activeTab",
		"scripting",
		"contextMenus",
		"sidePanel"
	],
	"host_permissions": [
		"https://sis.portal.nyu.edu/*",
		"https://sis.nyu.edu/*",
		"https://www.ratemyprofessors.com/*"
	],
	"background": {
		"service_worker": "src/background.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["https://sis.portal.nyu.edu/*", "https://sis.nyu.edu/*"],
			"js": ["src/content.js"],
			"css": ["src/content.css"],
			"run_at": "document_idle",
			"all_frames": true,
			"match_about_blank": true
		}
	],
	"action": {
		"default_popup": "src/popup.html",
		"default_title": "Albert Planner",
		"default_icon": {
			"16": "assets/icon16.png",
			"48": "assets/icon48.png",
			"128": "assets/icon128.png"
		}
	},
	"side_panel": {
		"default_path": "src/popup.html?mode=sidepanel"
	},
	"icons": {
		"16": "assets/icon16.png",
		"48": "assets/icon48.png",
		"128": "assets/icon128.png"
	},
	"commands": {
		"open-planner": {
			"description": "Open the weekly schedule planner"
		}
	},
	"web_accessible_resources": [
		{
			"resources": [
				"src/popup.html",
				"src/popup.css",
				"src/popup.js",
				"src/weekly-view.html",
				"src/weekly-view.css",
				"src/weekly-view.js",
				"src/weekly-view/config.js",
				"src/weekly-view/context.js",
				"src/weekly-view/colors.js",
				"src/weekly-view/layout.js",
				"src/weekly-view/ui-feedback.js",
				"src/weekly-view/calendar-grid.js",
				"src/weekly-view/calendar-export.js",
				"src/weekly-view/bucket-actions.js",
				"src/weekly-view/metadata-drawer.js",
				"src/weekly-view/drag-drop.js",
				"src/weekly-view/course-blocks.js",
				"src/weekly-view/buckets.js",
				"src/course-storage.js",
				"src/planner.js",
				"src/bucket-manager.js",
				"src/utils/constants.js",
				"src/utils/calendar-utils.js",
				"src/utils/time-parser.js"
			],
			"matches": ["https://sis.portal.nyu.edu/*", "https://sis.nyu.edu/*"]
		}
	]
}
